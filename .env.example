# Direct mode (no server): the app talks to Supabase with the PUBLISHABLE (anon) key.
# Safe to put in the app, because the database rules limit what it can do. NEVER put a secret / service-role key here:
# everything in EXPO_PUBLIC_* is readable by anyone who opens the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Server mode instead: the address of the verifier service (see server/README.md). Ignored if the two above are set.
# EXPO_PUBLIC_VERIFIER_URL=http://192.168.1.10:8787
