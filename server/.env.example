# Used by the review job, the chest tool and the verifier service. Keep this file private; never commit it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SECRET key (service_role or sb_secret_...). It bypasses the database rules. It must never be in the app.
SUPABASE_SERVICE_KEY=

# Optional
# REQUIRE_SEEKER=1
# RPC_URL=https://api.mainnet-beta.solana.com
# REVIEW_DB=./review.db

# The admin portal (npm run admin) refuses to start without a password of at least 8 characters.
ADMIN_PASSWORD=
