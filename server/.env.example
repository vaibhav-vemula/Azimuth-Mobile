# Used by the review job, the chest tool and the verifier service. Keep this file private; never commit it.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The SECRET key (service_role or sb_secret_...). It bypasses the database rules. It must never be in the app.
SUPABASE_SERVICE_KEY=

# Optional
# REQUIRE_SEEKER=1
# RPC_URL=https://api.mainnet-beta.solana.com
# REVIEW_DB=./review.db

# The admin portal (npm run admin) refuses to start without a password of at least 8 characters.
ADMIN_PASSWORD=

# AZMTest on-chain payouts (devnet). Leave these out to run without paying tokens.
# The authority keypair pays fees and signs rewards. Keep the file outside the repo.
# AZM_AUTHORITY_KEYPAIR=~/.config/solana/devnet.json
# AZM_PROGRAM_ID=   # from onchain/devnet.json
# AZM_MINT=         # from onchain/devnet.json
# SOLANA_RPC=https://api.devnet.solana.com
# Amounts in whole AZMTest (defaults shown)
# AZM_MAPPING_MAX=50
# AZM_CELLS_PER_TOKEN=5
# AZM_SATELLITE=25
# AZM_CHEST=10
