{
  "name": "azimuth",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "server": "npm --prefix server start",
    "test:server": "npm --prefix server test",
    "verify-report": "node server/lib/verify-report.cjs"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^11.5.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@onsol/tldparser": "^1.2.1",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.5.0",
    "@solana-mobile/mobile-wallet-adapter-protocol": "^2.3.0",
    "@solana-mobile/mobile-wallet-adapter-protocol-web3js": "^2.3.0",
    "@solana/web3.js": "^1.99.0",
    "bs58": "^4.0.1",
    "buffer": "^6.0.3",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-gl": "~57.0.2",
    "expo-keep-awake": "~57.0.0",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-sensors": "~57.0.3",
    "expo-sharing": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "fflate": "^0.8.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "^2.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "satellite.js": "^7.1.0",
    "three": "^0.177.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bs58": "^4.0.4",
    "@types/geojson": "^7946.0.16",
    "@types/jest": "29.5.14",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "@types/three": "^0.177.0",
    "babel-preset-expo": "^57.0.13",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "react-test-renderer": "^19.2.3",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|satellite.js|@solana|@solana-mobile|@noble|jayson|uuid))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "transform": {
      "\\.mjs$": "babel-jest"
    },
    "moduleNameMapper": {
      "^satellite\\.js$": "<rootDir>/node_modules/satellite.js/dist/index.js",
      "^rpc-websockets$": "<rootDir>/jest.rpc-websockets-stub.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/server/"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "private": true,
  "overrides": {
    "@onsol/tldparser": {
      "buffer": "$buffer"
    }
  }
}
