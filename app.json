{
  "expo": {
    "name": "Azimuth",
    "slug": "azimuth",
    "scheme": "azimuth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05070D",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070D"
    },
    "android": {
      "package": "com.azimuth.v1",
      "adaptiveIcon": {
        "backgroundColor": "#04070E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Azimuth uses your location to predict when satellites pass overhead."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4DD0E1"
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-camera",
        {
          "cameraPermission": "Azimuth uses the camera to show treasure chests in AR where they really are.",
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withAzimuthBackup"
    ]
  }
}
